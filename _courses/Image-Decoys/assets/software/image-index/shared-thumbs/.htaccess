# Uploaded files are only ever served as plain files, never executed.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|phar|pl|py|cgi)$">
  Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
